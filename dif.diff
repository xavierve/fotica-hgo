       "publisher" (dict "@id" $orgId)
 ) -}}
 
+{{/* ---------- 3b. Equipo (Person), solo en la página que los presenta ----------
+     No se repite en cada página (serían 7 Person con bio completa en el JSON-LD
+     de TODO el sitio): solo en /nosotros/, que es donde vive el contenido real
+     de equipo. Se vinculan a la Organization vía worksFor (equivalente válido a
+     Organization.employee, sin tener que reconstruir el nodo $org ya añadido
+     al @graph más arriba).
+     Juan lleva además hasCredential (máster + certificación TRT) e identifier
+     (número de colegiado) — datos reales, no relleno: ver 214 (Baja Visión) y
+     315 (Rehabilitación Auditiva)/313 (Tinnitus), donde ya se mencionan en el
+     copy. Pendiente natural: referenciar este mismo @id desde esas páginas
+     (provider en su nodo Service) en vez de repetir los datos — no lo hago
+     aquí para no mezclar tareas. */}}
+{{- if eq .RelPermalink "/nosotros/" -}}
+  {{- range .Params.sections -}}
+    {{- if eq .type "team" -}}
+      {{- range .items -}}
+        {{- $personId := printf "%s#person-%s" $base (anchorize .name) -}}
+        {{- $person := dict
+              "@type" "Person"
+              "@id" $personId
+              "name" .name
+              "worksFor" (dict "@id" $orgId)
+        -}}
+        {{- with .role }}{{ $person = merge $person (dict "jobTitle" .) }}{{ end -}}
+        {{- with .image }}{{ $person = merge $person (dict "image" (. | absURL)) }}{{ end -}}
+        {{- with .bio }}{{ $person = merge $person (dict "description" .) }}{{ end -}}
+        {{- if eq .name "Juan" -}}
+          {{- $credentials := slice
+                (dict
+                  "@type" "EducationalOccupationalCredential"
+                  "credentialCategory" "degree"
+                  "name" "Máster Universitario en Rehabilitación Visual"
+                  "recognizedBy" (dict "@type" "CollegeOrUniversity" "name" "Universidad de Valladolid"))
+                (dict
+                  "@type" "EducationalOccupationalCredential"
+                  "credentialCategory" "certificate"
+                  "name" "Experto en Terapia de Reentrenamiento del Tinnitus (TRT)")
+          -}}
+          {{- $person = merge $person (dict "hasCredential" $credentials) -}}
+          {{- $person = merge $person (dict "identifier" (dict "@type" "PropertyValue" "propertyID" "Número de colegiado" "value" "22762")) -}}
+        {{- end -}}
+        {{- $graph = $graph | append $person -}}
+      {{- end -}}
+    {{- end -}}
+  {{- end -}}
+{{- end -}}
+
 {{/* ---------- 4. Nodo de la página actual ---------- */}}
 {{- $pageType := $schema.type | default (cond .IsHome "WebPage" "WebPage") -}}
 {{- $pageId := printf "%s#%s" .Permalink (lower $pageType) -}}
