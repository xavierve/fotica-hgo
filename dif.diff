@@ -1110,7 +1110,7 @@ h2.fs-xs {
 }
 
 /* === Gallery: object-position:top en vez del center por defecto.
-   Motivo: fachadas verticales (p.ej. avenida-fachada.webp, 1440x2160) forzadas a
+   Motivo: fachadas verticales (p.ej. andalucia-fachada.webp, 1440x2160) forzadas a
    la caja 4/3 existente pierden ~40% de la imagen; con center-crop eso significa
    cortar el rótulo "Fausto" de la parte superior, justo el elemento de marca que
    más importa en una foto de fachada. object-position:top ancla el recorte arriba
@@ -1166,4 +1166,98 @@ h2.fs-xs {
   .text-split-inner {
     grid-template-columns: 1fr 1fr
   }
-}
\ No newline at end of file
+}
+/* === bloque locations ====================================================
+   Sedes desde site.yaml. Dos layouts:
+     .locations-full    -> con imagen de mapa/fachada (pagina Contacto)
+     .locations-compact -> solo texto y enlaces (home, footer de seccion)
+   Los iconos y el color de enlace heredan de la superficie (--bg-text-color),
+   asi que el bloque funciona sobre fondo claro y sobre banda oscura. */
+.locations-grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: clamp(1.5rem, 4vw, 2.5rem);
+}
+.location-media {
+  display: block;
+  margin-bottom: .9rem;
+  border-radius: 12px;
+  overflow: hidden;
+}
+.location-media img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+.location-name {
+  margin: 0 0 .4rem;
+  font-size: 1.15em;
+}
+.location-meta {
+  display: flex;
+  flex-direction: column;
+  gap: .35rem;
+  font-style: normal;
+}
+.location-meta a,
+.locations-common-links a {
+  display: inline-flex;
+  align-items: center;
+  gap: .45rem;
+  color: var(--color-accent-text);
+  font-weight: 600;
+  text-decoration: none;
+}
+.location-meta a:hover,
+.locations-common-links a:hover {
+  text-decoration: underline;
+}
+.locations-common {
+  margin-top: clamp(1.75rem, 4vw, 2.5rem);
+}
+.locations-common h3 {
+  margin: 0 0 .6rem;
+}
+.locations-common-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .4rem 1.5rem;
+  margin: 0 0 .6rem;
+}
+/* Horario — partial hours.html, usado en footer, contacto y locations */
+.hours {
+  display: flex;
+  align-items: flex-start;
+  gap: .45rem;
+}
+.hours-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.hours-list li {
+  margin: 0;
+}
+.footer-grid .hours {
+  margin-top: .75rem;
+}
+/* En superficie con fondo propio los enlaces siguen el par de color */
+.has-surface .location-meta a,
+.has-surface .locations-common-links a {
+  color: inherit;
+}
+/* El layout compacto centra si el bloque lo pide (align: center) */
+.block-align-center .location-meta {
+  align-items: center;
+}
+.block-align-center .locations-common-links {
+  justify-content: center;
+}
+.block-align-center .hours {
+  justify-content: center;
+}
+@media(min-width:821px) {
+  .locations-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
diff --git a/themes/f1-theme/layouts/partials/blocks/locations.html b/themes/f1-theme/layouts/partials/blocks/locations.html
new file mode 100644
index 0000000..9797f48
--- /dev/null
+++ b/themes/f1-theme/layouts/partials/blocks/locations.html
@@ -0,0 +1,61 @@
+{{- /*
+  blocks/locations.html — sedes del negocio desde data/site.yaml.
+
+  NO recibe direcciones ni telefonos por parametro: los lee de site.locations[]
+  para que exista una sola fuente de verdad (la misma que consume footer.html
+  y schema.html). Si cambia un telefono, se cambia en site.yaml y punto.
+
+  sections:
+    - type: locations
+      title: "Dos centros en Torre del Mar para estar siempre cerca"
+      subtitle: "Contamos con dos centros..."
+      layout: compact        # compact (sin imagen) | full (con imagen, por defecto)
+      showCommon: true       # anade movil/WhatsApp, email y horario comunes
+
+  Cada sede usa de site.yaml: name, address, location, phone, phoneLabel,
+  mapUrl y -- solo en layout full -- image + imageAlt.
+*/ -}}
+{{- $siteData := site.Data.site -}}
+{{- $locations := $siteData.locations | default slice -}}
+{{- $contact := $siteData.contact | default dict -}}
+{{- $compact := eq (.layout | default "full") "compact" -}}
+{{- $extra := slice (printf "locations-%s" (cond $compact "compact" "full")) -}}
+<section class="{{ partial "block-classes.html" (dict "name" "locations" "context" . "extra" $extra) }}">
+  <div class="container">
+    {{ with .title }}<h2>{{ . }}</h2>{{ end }}
+    {{ with .subtitle }}<p class="section-subtitle">{{ . }}</p>{{ end }}
+    <div class="locations-grid">
+      {{ range $locations }}
+      {{- $loc := . -}}
+      <article class="location-card">
+        {{ if and (not $compact) $loc.image }}
+        <a class="location-media" href="{{ $loc.mapUrl | safeURL }}">
+          {{ partial "responsive-img.html" (dict "src" $loc.image "alt" ($loc.imageAlt | default (printf "Ubicación de %s en el mapa" $loc.name)) "sizes" "(min-width:821px) 50vw, 100vw") }}
+        </a>
+        {{ end }}
+        <h3 class="location-name">{{ $loc.name }}</h3>
+        <address class="location-meta">
+          {{ if $loc.mapUrl }}
+          <a href="{{ $loc.mapUrl | safeURL }}">{{ partial "icons.html" "location" }}<span>{{ $loc.address }}{{ with $loc.location }} · {{ . }}{{ end }}</span></a>
+          {{ else }}
+          <span>{{ partial "icons.html" "location" }}<span>{{ $loc.address }}{{ with $loc.location }} · {{ . }}{{ end }}</span></span>
+          {{ end }}
+          {{ with $loc.phone }}
+          <a href="{{ printf "tel:%s" . | safeURL }}">{{ partial "icons.html" "phone" }}<span>{{ $loc.phoneLabel | default . }}</span></a>
+          {{ end }}
+        </address>
+      </article>
+      {{ end }}
+    </div>
+    {{ if .showCommon }}
+    <div class="locations-common">
+      <h3>Común a ambos centros</h3>
+      <p class="locations-common-links">
+        {{ with $contact.whatsapp }}<a href="{{ printf "https://wa.me/%s" (replace . "+" "") | safeURL }}">{{ partial "icons.html" "whatsapp" }}<span>Móvil / WhatsApp: {{ $contact.phoneLabel | default . }}</span></a>{{ end }}
+        {{ with $contact.email }}<a href="{{ printf "mailto:%s" . | safeURL }}">{{ partial "icons.html" "email" }}<span>{{ . }}</span></a>{{ end }}
+      </p>
+      {{ partial "hours.html" . }}
+    </div>
+    {{ end }}
+  </div>
+</section>
