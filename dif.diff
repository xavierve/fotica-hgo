+
+/* === Presencia de bloques con imagen de fondo ===
+   Un bloque CON foto no necesita mas separacion (padding), necesita SUPERFICIE
+   para que la imagen se lea como escena y no como una tira. Mobile-first: en
+   movil el ancho es corto, asi que la altura tiene que hacer todo el trabajo;
+   en desktop el ancho ya da presencia y basta con menos. Solo aplica a banner
+   y cta con `bg` -- un bloque sin foto solo necesita su padding normal. */
+.block-banner.has-bg-image,
+.block-cta.has-bg-image{min-height:70vh;min-height:70svh;display:grid;place-items:center}
+/* En movil, la foto llega a borde: el margen lateral del .container solo
+   aporta aire donde ya sobra y encoge la imagen justo donde menos espacio hay. */
+@media(max-width:820px){
+  .block-banner.has-bg-image>.container,
+  .block-cta.has-bg-image>.container{width:100%;padding-inline:1.25rem}
+}
+@media(min-width:821px){
+  .block-banner.has-bg-image,
+  .block-cta.has-bg-image{min-height:420px}
+}
